هِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ',\n      translations: {\n        english: 'The path of those upon whom You have bestowed favor, not of those who have earned anger nor of those who are astray',\n        urdu: 'ان لوگوں کا راستہ جن پر تو نے انعام فرمایا، نہ ان کا جن پر غضب ہوا اور نہ گمراہوں کا'\n      }\n    }],\n    36: [{\n      number: 1,\n      arabic: 'يس',\n      translations: {\n        english: 'Ya, Sin.',\n        urdu: 'یٰسٓ'\n      }\n    }, {\n      number: 2,\n      arabic: 'وَالْقُرْآنِ الْحَكِيمِ',\n      translations: {\n        english: 'By the wise Quran.',\n        urdu: 'حکمت والے قرآن کی قسم'\n      }\n    }, {\n      number: 3,\n      arabic: 'إِنَّكَ لَمِنَ الْمُرْسَلِينَ',\n      translations: {\n        english: 'Indeed you are from among the messengers',\n        urdu: 'بیشک آپ رسولوں میں سے ہیں'\n      }\n    }, {\n      number: 4,\n      arabic: 'عَلَىٰ صِرَاطٍ مُّسْتَقِيمٍ',\n      translations: {\n        english: 'On a straight path.',\n        urdu: 'سیدھے راستے پر ہیں'\n      }\n    }, {\n      number: 5,\n      arabic: 'تَنزِيلَ الْعَزِيزِ الرَّحِيمِ',\n      translations: {\n        english: 'A revelation of the Exalted in Might, the Merciful.',\n        urdu: 'یہ غالب مہربان کا نازل کردہ ہے'\n      }\n    }],\n    55: [{\n      number: 1,\n      arabic: 'الرَّحْمَٰنُ',\n      translations: {\n        english: 'The Most Merciful',\n        urdu: 'رحمٰن'\n      }\n    }, {\n      number: 2,\n      arabic: 'عَلَّمَ الْقُرْآنَ',\n      translations: {\n        english: 'Taught the Quran',\n        urdu: 'اس نے قرآن سکھایا'\n      }\n    }, {\n      number: 3,\n      arabic: 'خَلَقَ الْإِنسَانَ',\n      translations: {\n        english: 'Created man',\n        urdu: 'انسان کو پیدا کیا'\n      }\n    }, {\n      number: 4,\n      arabic: 'عَلَّمَهُ الْبَيَانَ',\n      translations: {\n        english: 'Taught him eloquence',\n        urdu: 'اسے بولنا سکھایا'\n      }\n    }, {\n      number: 5,\n      arabic: 'الشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ',\n      translations: {\n        english: 'The sun and the moon follow courses precisely computed',\n        urdu: 'سورج اور چاند حساب میں ہیں'\n      }\n    }, {\n      number: 6,\n      arabic: 'وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَانِ',\n      translations: {\n        english: 'And the stars and trees prostrate',\n        urdu: 'اور تارے اور درخت سجدہ کرتے ہیں'\n      }\n    }, {\n      number: 7,\n      arabic: 'وَالسَّمَاءَ رَفَعَهَا وَوَضَعَ الْمِيزَانَ',\n      translations: {\n        english: 'And the heaven He raised and imposed the balance',\n        urdu: 'اور آسمان کو بلند کیا اور ترازو مقرر کی'\n      }\n    }, {\n      number: 13,\n      arabic: 'فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ',\n      translations: {\n        english: 'So which of the favors of your Lord would you deny?',\n        urdu: 'تو تم اپنے رب کی کون کون سی نعمت کو جھٹلاؤ گے'\n      }\n    }],\n    67: [{\n      number: 1,\n      arabic: 'تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ',\n      translations: {\n        english: 'Blessed is He in whose hand is dominion, and He is over all things competent',\n        urdu: 'بڑی بابرکت ہے وہ ذات جس کے ہاتھ میں بادشاہت ہے اور وہ ہر چیز پر قادر ہے'\n      }\n    }, {\n      number: 2,\n      arabic: 'الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا',\n      translations: {\n        english: 'He who created death and life to test you as to which of you is best in deed',\n        urdu: 'جس نے موت اور زندگی کو پیدا کیا تاکہ تمہیں آزمائے کہ تم میں سے کون بہتر عمل کرتا ہے'\n      }\n    }, {\n      number: 3,\n      arabic: 'الَّذِي خَلَقَ سَبْعَ سَمَاوَاتٍ طِبَاقًا',\n      translations: {\n        english: 'He who created seven heavens in layers',\n        urdu: 'جس نے سات آسمان تہ بہ تہ بنائے'\n      }\n    }, {\n      number: 4,\n      arabic: 'مَّا تَرَىٰ فِي خَلْقِ الرَّحْمَٰنِ مِن تَفَاوُتٍ',\n      translations: {\n        english: 'You do not see in the creation of the Most Merciful any inconsistency',\n        urdu: 'تم رحمٰن کی تخلیق میں کوئی بے ترتیبی نہ پاؤ گے'\n      }\n    }],\n    93: [{\n      number: 1,\n      arabic: 'وَالضُّحَىٰ',\n      translations: {\n        english: 'By the morning brightness',\n        urdu: 'قسم ہے چاشت کی'\n      }\n    }, {\n      number: 2,\n      arabic: 'وَاللَّيْلِ إِذَا سَجَىٰ',\n      translations: {\n        english: 'And by the night when it covers with darkness',\n        urdu: 'اور رات کی جب وہ چھا جائے'\n      }\n    }, {\n      number: 3,\n      arabic: 'مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ',\n      translations: {\n        english: 'Your Lord has not taken leave of you, nor has He detested you',\n        urdu: 'تمہارے رب نے تمہیں نہ چھوڑا اور نہ ناراض ہوا'\n      }\n    }, {\n      number: 4,\n      arabic: 'وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ',\n      translations: {\n        english: 'And the Hereafter is better for you than the first life',\n        urdu: 'اور آخرت تمہارے لیے دنیا سے بہتر ہے'\n      }\n    }, {\n      number: 5,\n      arabic: 'وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ',\n      translations: {\n        english: 'And your Lord is going to give you, and you will be satisfied',\n        urdu: 'اور عنقریب تمہارا رب تمہیں دے گا اور تم راضی ہو جاؤ گے'\n      }\n    }, {\n      number: 6,\n      arabic: 'أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ',\n      translations: {\n        english: 'Did He not find you an orphan and give you refuge?',\n        urdu: 'کیا اس نے تمہیں یتیم نہیں پایا اور ٹھکانا دیا'\n      }\n    }, {\n      number: 7,\n      arabic: 'وَوَجَدَكَ ضَالًّا فَهَدَىٰ',\n      translations: {\n        english: 'And He found you lost and guided you',\n        urdu: 'اور تمہیں بے خبر پایا تو رہنمائی کی'\n      }\n    }, {\n      number: 8,\n      arabic: 'وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ',\n      translations: {\n        english: 'And He found you poor and made you self-sufficient',\n        urdu: 'اور تمہیں محتاج پایا تو غنی کر دیا'\n      }\n    }, {\n      number: 9,\n      arabic: 'فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ',\n      translations: {\n        english: 'So as for the orphan, do not oppress him',\n        urdu: 'پس یتیم پر سختی نہ کرو'\n      }\n    }, {\n      number: 10,\n      arabic: 'وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ',\n      translations: {\n        english: 'And as for the petitioner, do not repel him',\n        urdu: 'اور مانگنے والے کو نہ جھڑکو'\n      }\n    }, {\n      number: 11,\n      arabic: 'وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ',\n      translations: {\n        english: 'But as for the favor of your Lord, report it',\n        urdu: 'اور اپنے رب کی نعمت کا تذکرہ کرو'\n      }\n    }],\n    97: [{\n      number: 1,\n      arabic: 'إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ',\n      translations: {\n        english: 'Indeed, We sent the Quran down during the Night of Decree',\n        urdu: 'بیشک ہم نے اسے شب قدر میں نازل کیا'\n      }\n    }, {\n      number: 2,\n      arabic: 'وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ',\n      translations: {\n        english: 'And what can make you know what is the Night of Decree?',\n        urdu: 'اور تمہیں کیا معلوم شب قدر کیا ہے'\n      }\n    }, {\n      number: 3,\n      arabic: 'لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ',\n      translations: {\n        english: 'The Night of Decree is better than a thousand months',\n        urdu: 'شب قدر ہزار مہینوں سے بہتر ہے'\n      }\n    }, {\n      number: 4,\n      arabic: 'تَنَزَّلُ الْمَلَائِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ',\n      translations: {\n        english: 'The angels and the Spirit descend therein by permission of their Lord for every matter',\n        urdu: 'اس میں فرشتے اور روح الامین اپنے رب کے حکم سے ہر کام کے لیے اترتے ہیں'\n      }\n    }, {\n      number: 5,\n      arabic: 'سَلَامٌ هِيَ حَتَّىٰ مَطْلَعِ الْفَجْرِ',\n      translations: {\n        english: 'Peace it is until the emergence of dawn',\n        urdu: 'وہ رات سراسر سلامتی ہے طلوع فجر تک'\n      }\n    }],\n    103: [{\n      number: 1,\n      arabic: 'وَالْعَصْرِ',\n      translations: {\n        english: 'By time',\n        urdu: 'زمانے کی قسم'\n      }\n    }, {\n      number: 2,\n      arabic: 'إِنَّ الْإِنسَانَ لَفِي خُسْرٍ',\n      translations: {\n        english: 'Indeed, mankind is in loss',\n        urdu: 'بیشک انسان خسارے میں ہے'\n      }\n    }, {\n      number: 3,\n      arabic: 'إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ',\n      translations: {\n        english: 'Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience',\n        urdu: 'سوائے ان لوگوں کے جو ایمان لائے اور نیک عمل کیے اور ایک دوسرے کو حق کی تلقین کی اور صبر کی نصیحت کی'\n      }\n    }],\n    108: [{\n      number: 1,\n      arabic: 'إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ',\n      translations: {\n        english: 'Indeed, We have granted you Al-Kawthar',\n        urdu: 'بیشک ہم نے تمہیں کوثر عطا کی'\n      }\n    }, {\n      number: 2,\n      arabic: 'فَصَلِّ لِرَبِّكَ وَانْحَرْ',\n      translations: {\n        english: 'So pray to your Lord and sacrifice',\n        urdu: 'پس اپنے رب کے لیے نماز پڑھو اور قربانی کرو'\n      }\n    }, {\n      number: 3,\n      arabic: 'إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ',\n      translations: {\n        english: 'Indeed, your enemy is the one cut off',\n        urdu: 'بیشک تمہارا دشمن ہی بے نام و نشان ہے'\n      }\n    }],\n    112: [{\n      number: 1,\n      arabic: 'قُلْ هُوَ اللَّهُ أَحَدٌ',\n      translations: {\n        english: 'Say, \"He is Allah, the One\"',\n        urdu: 'کہو وہ اللہ ایک ہے'\n      }\n    }, {\n      number: 2,\n      arabic: 'اللَّهُ الصَّمَدُ',\n      translations: {\n        english: 'Allah, the Eternal Refuge',\n        urdu: 'اللہ بے نیاز ہے'\n      }\n    }, {\n      number: 3,\n      arabic: 'لَمْ يَلِدْ وَلَمْ يُولَدْ',\n      translations: {\n        english: 'He neither begets nor is born',\n        urdu: 'نہ اس کی کوئی اولاد ہے اور نہ وہ کسی کی اولاد ہے'\n      }\n    }, {\n      number: 4,\n      arabic: 'وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ',\n      translations: {\n        english: 'Nor is there to Him any equivalent',\n        urdu: 'اور کوئی اس کا ہمسر نہیں'\n      }\n    }],\n    113: [{\n      number: 1,\n      arabic: 'قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ',\n      translations: {\n        english: 'Say, \"I seek refuge in the Lord of daybreak\"',\n        urdu: 'کہو میں صبح کے رب کی پناہ مانگتا ہوں'\n      }\n    }, {\n      number: 2,\n      arabic: 'مِن شَرِّ مَا خَلَقَ',\n      translations: {\n        english: 'From the evil of that which He created',\n        urdu: 'ہر اس چیز کے شر سے جو اس نے پیدا کی'\n      }\n    }, {\n      number: 3,\n      arabic: 'وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ',\n      translations: {\n        english: 'And from the evil of darkness when it settles',\n        urdu: 'اور اندھیری رات کے شر سے جب وہ چھا جائے'\n      }\n    }, {\n      number: 4,\n      arabic: 'وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ',\n      translations: {\n        english: 'And from the evil of the blowers in knots',\n        urdu: 'اور گرہوں میں پھونکنے والیوں کے شر سے'\n      }\n    }, {\n      number: 5,\n      arabic: 'وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ',\n      translations: {\n        english: 'And from the evil of an envier when he envies',\n        urdu: 'اور حسد کرنے والے کے شر سے جب وہ حسد کرے'\n      }\n    }],\n    114: [{\n      number: 1,\n      arabic: 'قُلْ أَعُوذُ بِرَبِّ النَّاسِ',\n      translations: {\n        english: 'Say, \"I seek refuge in the Lord of mankind\"',\n        urdu: 'کہو میں لوگوں کے رب کی پناہ مانگتا ہوں'\n      }\n    }, {\n      number: 2,\n      arabic: 'مَلِكِ النَّاسِ',\n      translations: {\n        english: 'The Sovereign of mankind',\n        urdu: 'لوگوں کے بادشاہ کی'\n      }\n    }, {\n      number: 3,\n      arabic: 'إِلَٰهِ النَّاسِ',\n      translations: {\n        english: 'The God of mankind',\n  